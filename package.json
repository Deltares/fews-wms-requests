{
  "name": "@deltares/fews-wms-requests",
  "version": "4.1.0",
  "description": "Library for making requests to the FEWS WMS-T webservice",
  "author": {
    "name": "Werner Kramer",
    "email": "werner.kramer@deltares.nl"
  },
  "license": "MIT",
  "keywords": [
    "FEWS",
    "Delft-FEWS",
    "Web Map Services",
    "WMS-T",
    "WMS",
    "OGC:WMS"
  ],
  "private": false,
  "type": "module",
  "module": "./dist/fews-wms-requests.js",
  "exports": {
    ".": {
      "import": "./dist/fews-wms-requests.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "doc": "typedoc src/index.ts",
    "lint": "eslint . | npm run prettier",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "format": "prettier .  --write",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test": "vitest",
    "json2ts": "node scripts/generateTypes.js wms",
    "sonar": "sonar-scanner -Dsonar.host.url=$SONAR_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.projectKey=$SONAR_KEY -Dsonar.projectName='Delft-FEWS Web OC WMS Requests'"
  },
  "dependencies": {
    "@deltares/fews-web-oc-utils": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fetch-mock": "^12.6.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deltares/fews-wms-requests"
  },
  "bugs": {
    "url": "https://github.com/Deltares/fews-wms-requests/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "volta": {
    "node": "24.18.0"
  }
}
